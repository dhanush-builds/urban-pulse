# copy to .env and fill in; .env is git-ignored
DB_HOST=127.0.0.1
DB_PORT=5433
DB_USER=postgres
DB_PASSWORD=
DB_NAME=urban_pulse_db

# optional, a free Socrata app token makes the API faster
SOCRATA_APP_TOKEN=

# hosted database (Neon, Supabase...): use its values and turn SSL on
# DB_HOST=your-host.neon.tech
# DB_PORT=5432
# DB_USER=your_user
# DB_NAME=neondb
# PGSSLMODE=require
